<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Constructor del problema de investigación</title>
  <meta name="description" content="Recorrido guiado para delimitar un tema y construir un problema de investigación.">
  <style>
    :root{--ink:#123d32;--soft:#45665d;--orange:#ee6b29;--orange2:#fff0e7;--paper:#f6f2e9;--card:#fffdf8;--line:#d8d3c8;--shadow:0 18px 50px #17382e18}
    [data-theme=dark]{--ink:#eff8f3;--soft:#b8ccc3;--orange:#ff8650;--orange2:#3b271f;--paper:#11201b;--card:#182a24;--line:#345047;--shadow:0 18px 50px #0005}
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:Arial,sans-serif;transition:.25s}button,input,textarea,select{font:inherit;color:inherit}
    header{max-width:1180px;margin:auto;padding:18px 24px;display:flex;justify-content:flex-end;align-items:center}.theme{border:1px solid var(--line);background:var(--card);border-radius:99px;padding:9px 14px;cursor:pointer}
    .hero{max-width:1180px;margin:auto;padding:72px 30px 78px;display:grid;grid-template-columns:1.4fr .6fr;gap:40px;align-items:center}.eyebrow{color:var(--orange);font-weight:bold;font-size:11px;letter-spacing:.15em;text-transform:uppercase}.hero h1{font:500 clamp(46px,6.2vw,78px)/.98 Georgia,serif;letter-spacing:-.045em;margin:18px 0}.hero h1 em{color:var(--orange)}.hero p{max-width:710px;color:var(--soft);line-height:1.7;font-size:17px}.visual{width:290px;aspect-ratio:1;border:1px solid var(--line);border-radius:50%;display:grid;place-items:center;position:relative}.visual:before,.visual:after{content:"";position:absolute;inset:17%;border:1px solid var(--line);border-radius:50%;transform:rotate(45deg) scaleY(.65)}.visual:after{transform:rotate(-35deg) scaleY(.65)}.visual div{z-index:2;width:138px;height:138px;border-radius:50%;background:var(--ink);color:var(--paper);display:grid;place-items:center;text-align:center;font:22px Georgia}.visual i{color:var(--orange);font-style:normal}
    .app{max-width:1180px;margin:0 auto 90px;padding:0 24px;display:grid;grid-template-columns:270px 1fr;gap:24px;align-items:start}.nav,.panel{border:1px solid var(--line);background:var(--card);border-radius:23px}.nav{padding:26px;position:sticky;top:20px}.nav>small{font-weight:bold;text-transform:uppercase;letter-spacing:.15em}.bar{height:5px;background:var(--paper);border-radius:9px;margin:13px 0 22px;overflow:hidden}.bar i{display:block;height:100%;width:0;background:var(--orange);transition:.3s}.steps{list-style:none;padding:0;margin:0}.steps li{display:flex;gap:11px;align-items:center;opacity:.42;margin:0 0 19px}.steps li.on,.steps li.done{opacity:1}.steps b{width:29px;height:29px;display:grid;place-items:center;border:1px solid var(--line);border-radius:50%;font-size:11px}.steps .on b{background:var(--orange);border-color:var(--orange);color:white}.steps .done b{background:var(--ink);color:var(--paper)}.steps strong,.steps small{display:block}.steps strong{font-size:13px}.steps small{font-size:10px;color:var(--soft);margin-top:3px}.quote{margin-top:8px;padding:17px;background:var(--orange2);border-left:3px solid var(--orange);border-radius:13px;font:14px/1.5 Georgia}
    .panel{padding:38px 44px;box-shadow:var(--shadow);min-height:620px}.panelHead{border-bottom:1px solid var(--line);padding-bottom:20px;margin-bottom:25px;position:relative}.panelHead small{color:var(--orange);font-weight:bold;letter-spacing:.15em;text-transform:uppercase}.panelHead h2{font:500 34px Georgia;margin:7px 0 0}.panelHead span{position:absolute;right:0;top:17px;color:var(--soft);font-size:11px}.page{display:none}.page.on{display:grid;grid-template-columns:1fr 1fr;gap:20px}.field{display:flex;flex-direction:column;gap:8px}.field.full,.sourceType,.tip{grid-column:1/-1}.field span,.sourceType legend{font-weight:bold;font-size:12px}.field b{color:var(--orange)}input,textarea,select{width:100%;border:1px solid var(--line);background:var(--paper);border-radius:10px;padding:13px;outline:0}textarea{resize:vertical}input:focus,textarea:focus,select:focus{border-color:var(--orange);box-shadow:0 0 0 3px #ee6b2922}.invalid input,.invalid textarea{border-color:#c94232}.field small{font-size:10px;color:var(--soft)}.sourceType{border:0;padding:0;display:grid;grid-template-columns:repeat(3,1fr);gap:9px}.sourceType legend{margin-bottom:9px}.sourceType label{border:1px solid var(--line);background:var(--paper);border-radius:10px;padding:13px;cursor:pointer}.sourceType label.selected{border-color:var(--orange);box-shadow:inset 0 0 0 1px var(--orange);background:var(--orange2)}.sourceType input{position:absolute;opacity:0}.sourceType strong,.sourceType small{display:block}.sourceType strong{font-size:11px}.sourceType small{font-size:9px;color:var(--soft);line-height:1.35;margin-top:4px}.tip{padding:14px;background:var(--paper);border:1px dashed var(--line);border-radius:11px;font-size:11px;line-height:1.6}.actions{display:flex;justify-content:space-between;border-top:1px solid var(--line);padding-top:22px;margin-top:28px}.btn{border-radius:99px;padding:11px 18px;font-weight:bold;font-size:11px;cursor:pointer}.primary{border:1px solid var(--orange);background:var(--orange);color:white}.secondary{border:1px solid var(--line);background:transparent}.secondary:disabled{opacity:.35}.error{display:none;padding:11px 13px;background:#fff0ed;color:#912f23;border:1px solid #f6bbb2;border-radius:9px;font-size:12px;margin-bottom:18px}.error.on{display:block}
    .result{display:none;max-width:1132px;margin:0 auto 90px;padding:80px 0 0;border-top:1px solid var(--line)}.result.on{display:block}.result h2{font:500 clamp(38px,5vw,58px)/1.05 Georgia;margin:15px 0}.resultIntro{max-width:760px;color:var(--soft);line-height:1.7}.problem{background:var(--ink);color:var(--paper);border-radius:22px;padding:32px 36px;margin:35px 0}.problem small,.resultTitle small{color:var(--orange);text-transform:uppercase;font-weight:bold;letter-spacing:.14em}.problem h3{margin:6px 0 20px}.problem p{font:19px/1.65 Georgia;margin:0}.resultTitle{display:flex;justify-content:space-between;align-items:end;margin:45px 0 18px}.resultTitle h3{font:28px Georgia;margin:7px 0 0}.resultTitle p{max-width:340px;color:var(--soft);font-size:11px}.topics{display:grid;grid-template-columns:repeat(3,1fr);gap:13px}.topic,.derived{border:1px solid var(--line);background:var(--card);border-radius:16px;padding:22px}.topic{min-height:290px;display:flex;flex-direction:column;transition:.2s}.topic.selected{border-color:var(--orange);box-shadow:inset 0 0 0 1px var(--orange),0 12px 30px #ee6b291b;transform:translateY(-3px)}.topic small{color:var(--orange);font-weight:bold;text-transform:uppercase;letter-spacing:.14em}.topic h4{font:18px/1.45 Georgia;margin:20px 0}.topic>p{color:var(--soft);font-size:11px;margin:auto 0 18px}.topicActions{display:flex;flex-wrap:wrap;gap:7px}.topicActions button{padding:8px 12px}.topic.selected .selectRoute{background:var(--orange);border-color:var(--orange);color:white}.selectedRoute{margin-top:18px;color:var(--orange);font-size:10px;font-weight:bold;letter-spacing:.12em;text-transform:uppercase}.derivedGrid{display:grid;grid-template-columns:1fr 1fr;gap:13px;margin-top:13px}.derived small{color:var(--orange);font-weight:bold;text-transform:uppercase;letter-spacing:.14em}.derived p{font:16px/1.55 Georgia}.resultActions{display:flex;justify-content:flex-end;gap:9px;margin-top:23px}.note{text-align:center;color:var(--soft);font-size:10px;line-height:1.6;max-width:760px;margin:25px auto}footer{border-top:1px solid var(--line);max-width:1180px;margin:auto;padding:30px 24px;color:var(--soft);font-size:10px}
    @media(max-width:850px){.hero{grid-template-columns:1fr}.visual{display:none}.app{grid-template-columns:1fr}.nav{position:static}.steps{display:grid;grid-template-columns:repeat(4,1fr)}.quote{display:none}.result{margin-inline:24px}.topics{grid-template-columns:1fr}.topic{min-height:160px}}
    @media(max-width:600px){header{padding:12px 16px}.theme{font-size:0}.theme:before{content:"☾";font-size:18px}.hero{padding:45px 20px 55px}.hero h1{font-size:45px}.app{padding:0 13px}.nav{padding:18px}.steps small{display:none}.steps strong{font-size:9px}.panel{padding:27px 19px}.panelHead h2{font-size:28px;padding-right:50px}.page.on,.sourceType,.derivedGrid{grid-template-columns:1fr}.sourceType label{grid-column:1}.result{margin-inline:17px;padding-top:60px}.problem{padding:26px 21px}.resultTitle{display:block}.resultActions{flex-wrap:wrap}}
  </style>
</head>
<body>
  <header><button class="theme" id="theme" type="button">☾ Modo oscuro</button></header>
  <section class="hero"><div><div class="eyebrow">— Herramienta académica interactiva</div><h1>Convierte una idea amplia en un <em>problema investigable.</em></h1><p>Recorre cuatro decisiones clave y obtén tres rutas de investigación. Cada una integra un tema delimitado, una pregunta investigable y un objetivo general coherente.</p></div><div class="visual" aria-hidden="true"><div>idea<br><i>problema</i><br>tema</div></div></section>
  <section class="app">
    <aside class="nav"><small>Tu recorrido</small><div class="bar"><i id="bar"></i></div><ol class="steps" id="steps"><li class="on"><b>1</b><div><strong>Punto de partida</strong><small>Intereses y experiencia</small></div></li><li><b>2</b><div><strong>Delimita</strong><small>Objeto, contexto y alcance</small></div></li><li><b>3</b><div><strong>Problematiza</strong><small>Tensión, vacío o necesidad</small></div></li><li><b>4</b><div><strong>Viabilidad</strong><small>Fuentes, método y tiempo</small></div></li></ol><div class="quote">El tema no nace de acumular información, sino de localizar una discusión o un aspecto aún no comprendido.</div></aside>
    <form class="panel" id="wizard" novalidate>
      <div class="panelHead"><small id="eyebrow">01 · Explora</small><h2 id="title">Tu punto de partida</h2><span id="counter">Paso 1 de 4</span></div><div class="error" id="error">Completa los campos señalados para continuar.</div>
      <div class="page on" data-step="0"><label class="field"><span>Nivel académico</span><select name="level"><option>Maestría</option><option>Doctorado</option><option>Especialidad</option><option>Licenciatura</option></select></label><label class="field" data-required><span>Disciplina o programa <b>*</b></span><input name="discipline" placeholder="Ej. Educación, Derecho, Salud…"></label><label class="field full" data-required><span>Tema general que te interesa <b>*</b></span><textarea name="interest" rows="3" placeholder="Ej. Uso ético de la inteligencia artificial en la enseñanza universitaria"></textarea><small>Escribe una idea amplia; la delimitaremos después.</small></label><label class="field full" data-required><span>¿Qué experiencia o conocimiento previo te conecta con este tema? <b>*</b></span><textarea name="experience" rows="3" placeholder="Cursos, práctica profesional o investigaciones previas"></textarea></label></div>
      <div class="page" data-step="1"><label class="field full" data-required><span>Fenómeno u objeto específico <b>*</b></span><textarea name="phenomenon" rows="3" placeholder="Ej. alfabetización en IA del profesorado"></textarea></label><label class="field" data-required><span>Personas, casos o materiales <b>*</b></span><input name="population" placeholder="Ej. docentes universitarios"></label><label class="field" data-required><span>Contexto o lugar <b>*</b></span><input name="place" placeholder="Ej. universidades de Guayaquil"></label><label class="field"><span>Periodo</span><input name="period" placeholder="Ej. ciclo académico 2026–2027"></label><div class="tip"><strong>Ejemplo de focalización:</strong> de “la IA en educación” a “la alfabetización en IA del profesorado universitario en Guayaquil durante 2026”.</div></div>
      <div class="page" data-step="2"><fieldset class="sourceType"><legend>¿De dónde surge la problemática?</legend><label class="selected"><input type="radio" name="problemType" value="Vacío de conocimiento" checked><strong>Vacío de conocimiento</strong><small>Falta comprender o caracterizar un aspecto</small></label><label><input type="radio" name="problemType" value="Debate entre posturas"><strong>Debate entre posturas</strong><small>La literatura presenta explicaciones contrapuestas</small></label><label><input type="radio" name="problemType" value="Problema de la práctica"><strong>Problema de la práctica</strong><small>Una situación real requiere explicación o mejora</small></label></fieldset><label class="field full" data-required><span>¿Qué se conoce o afirma actualmente? <b>*</b></span><textarea name="known" rows="3" placeholder="Resume el punto de partida según la literatura o tu contexto"></textarea></label><label class="field full" data-required><span>¿Qué sigue sin resolverse, comprenderse o mejorarse? <b>*</b></span><textarea name="gap" rows="3" placeholder="Formula la tensión central; evita responderla todavía"></textarea></label><label class="field full" data-required><span>¿Por qué importa resolverlo? <b>*</b></span><textarea name="consequence" rows="3" placeholder="Explica las consecuencias académicas, sociales o profesionales"></textarea></label></div>
      <div class="page" data-step="3"><label class="field full" data-required><span>Fuentes y datos disponibles <b>*</b></span><textarea name="sources" rows="3" placeholder="Artículos, bases de datos, participantes, instrumentos…"></textarea><small>Las fuentes deben ser accesibles y manejables.</small></label><label class="field" data-required><span>¿Cómo accederás a ellos? <b>*</b></span><textarea name="access" rows="3" placeholder="Permisos, convenios, bases abiertas…"></textarea></label><label class="field" data-required><span>Método o estrategia posible <b>*</b></span><textarea name="method" rows="3" placeholder="Ej. estudio de caso con entrevistas"></textarea></label><label class="field full" data-required><span>Tiempo y recursos reales <b>*</b></span><input name="time" placeholder="Ej. 8 meses; acceso institucional y software de análisis"></label><div class="tip"><strong>Comprobación rápida:</strong> experiencia pertinente · fuentes accesibles · método manejable · alcance compatible con el plazo.</div></div>
      <div class="actions"><button class="btn secondary" id="prev" type="button" disabled>← Anterior</button><button class="btn primary" id="next" type="submit">Continuar →</button></div>
    </form>
  </section>
  <section class="result" id="result"><div class="eyebrow">— Tu punto de partida</div><h2>Una propuesta para conversar, contrastar y mejorar.</h2><p class="resultIntro">El resultado conserva la relación entre problemática, tema, pregunta y objetivo. Selecciona una ruta y contrasta su formulación con la literatura especializada de tu disciplina.</p><article class="problem"><small>01 · Planteamiento orientativo</small><h3>Problema de investigación</h3><p id="problem"></p></article><div class="resultTitle"><div><small>02 · Tres rutas posibles</small><h3>Opciones de tema de investigación</h3></div><p>Elige una opción para consultar la pregunta y el objetivo general formulados específicamente para esa ruta.</p></div><div class="topics" id="topics"></div><div class="selectedRoute" id="selectedRoute"></div><div class="derivedGrid"><article class="derived"><small>03 · Pregunta de investigación</small><p id="question"></p></article><article class="derived"><small>04 · Objetivo general</small><p id="objective"></p></article></div><div class="resultActions"><button class="btn secondary" id="edit" type="button">Editar respuestas</button><button class="btn secondary" id="restart" type="button">Empezar de nuevo</button><button class="btn primary" id="download" type="button">Descargar resultado ↓</button></div><p class="note"><strong>Importante:</strong> esta propuesta es orientativa. No sustituye la revisión de antecedentes, la consulta con la dirección de tesis ni la comprobación de originalidad y viabilidad.</p></section>
  <footer>Constructor del problema de investigación · Basado en la secuencia conceptual del capítulo 2: determinación de un tema de investigación.</footer>
  <script>
  (()=>{
    const form=document.querySelector('#wizard'),pages=[...document.querySelectorAll('.page')],lis=[...document.querySelectorAll('.steps li')],heads=[['01 · Explora','Tu punto de partida'],['02 · Enfoca','Delimita el tema'],['03 · Cuestiona','Construye la problemática'],['04 · Comprueba','Revisa la viabilidad']];let step=0,last=null,selectedIndex=0;
    const clean=s=>(s||'').trim().replace(/[.?!,:;]+$/,'');const low=s=>s?s[0].toLowerCase()+s.slice(1):'';const up=s=>s?s[0].toUpperCase()+s.slice(1):'';const withArticle=s=>{const value=low(clean(s));if(/^(el|la|los|las|un|una|unos|unas)\s/i.test(value))return value;const first=value.split(/\s+/)[0],femininePlural=/(as|ciones|siones|dades|tades|tudes|umbres|ies|eces)$/i.test(first),plural=/s$/i.test(first),feminine=/(a|ción|sión|dad|tad|tud|umbre|ie|ez)$/i.test(first);return`${plural?(femininePlural?'las':'los'):(feminine?'la':'el')} ${value}`};
    const data=()=>Object.fromEntries(new FormData(form));
    const draw=()=>{pages.forEach((p,i)=>p.classList.toggle('on',i===step));lis.forEach((l,i)=>{l.className=i<step?'done':i===step?'on':'';l.querySelector('b').textContent=i<step?'✓':i+1});document.querySelector('#bar').style.width=(step/4*100)+'%';document.querySelector('#eyebrow').textContent=heads[step][0];document.querySelector('#title').textContent=heads[step][1];document.querySelector('#counter').textContent=`Paso ${step+1} de 4`;document.querySelector('#prev').disabled=step===0;document.querySelector('#next').textContent=step===3?'Construir mi propuesta ✦':'Continuar →';document.querySelector('#error').classList.remove('on')};
    const save=()=>localStorage.setItem('tesis-problema-html',JSON.stringify(data()));const restore=()=>{try{const d=JSON.parse(localStorage.getItem('tesis-problema-html'));if(d)Object.entries(d).forEach(([k,v])=>{const el=form.elements[k];if(!el)return;if(el instanceof RadioNodeList){[...el].forEach(r=>r.checked=r.value===v)}else el.value=v})}catch(e){}};
    const validate=()=>{let ok=true;pages[step].querySelectorAll('[data-required]').forEach(w=>{const el=w.querySelector('input,textarea');const bad=!clean(el.value);w.classList.toggle('invalid',bad);if(bad)ok=false});document.querySelector('#error').classList.toggle('on',!ok);return ok};
    const copyText=async text=>{try{await navigator.clipboard.writeText(text)}catch(e){const box=document.createElement('textarea');box.value=text;document.body.appendChild(box);box.select();document.execCommand('copy');box.remove()}};
    const renderSelected=()=>{const route=last.routes[selectedIndex];document.querySelector('#selectedRoute').textContent=`Formulaciones correspondientes a la opción ${String.fromCharCode(65+selectedIndex)} · ${route.focus}`;document.querySelector('#question').textContent=route.question;document.querySelector('#objective').textContent=route.objective;document.querySelectorAll('.topic').forEach((card,i)=>{card.classList.toggle('selected',i===selectedIndex);card.querySelector('.selectRoute').textContent=i===selectedIndex?'✓ Opción seleccionada':'Seleccionar opción'})};
    const renderRoutes=()=>{const container=document.querySelector('#topics');container.innerHTML='';last.routes.forEach((route,i)=>{const card=document.createElement('article');card.className='topic';const label=document.createElement('small');label.textContent=`Opción ${String.fromCharCode(65+i)}`;const title=document.createElement('h4');title.textContent=up(route.topic);const focus=document.createElement('p');focus.textContent=route.focus;const actions=document.createElement('div');actions.className='topicActions';const select=document.createElement('button');select.className='btn secondary selectRoute';select.type='button';select.onclick=()=>{selectedIndex=i;renderSelected()};const copy=document.createElement('button');copy.className='btn secondary';copy.type='button';copy.textContent='Copiar tema';copy.onclick=async()=>{await copyText(route.topic);copy.textContent='✓ Copiado';setTimeout(()=>copy.textContent='Copiar tema',1500)};actions.append(select,copy);card.append(label,title,focus,actions);container.appendChild(card)});renderSelected()};
    const build=()=>{
      const d=data(),subject=withArticle(clean(d.phenomenon)||clean(d.interest)),interest=withArticle(d.interest),discipline=clean(d.discipline),population=low(clean(d.population)),place=clean(d.place),period=clean(d.period),method=low(clean(d.method)),periodPhrase=period?` durante ${period}`:'',scope=`en ${place}, tomando como unidad de análisis ${population}${periodPhrase}`;
      const lead=d.problemType==='Debate entre posturas'?'una controversia teórica o empírica aún no resuelta':d.problemType==='Problema de la práctica'?'una problemática de la práctica que requiere comprensión y mejora':'un vacío de conocimiento que limita la comprensión del fenómeno';
      const problem=`En el campo de ${discipline}, el estudio de ${interest} constituye un ámbito de interés académico. Si bien ${low(clean(d.known))}, se identifica ${lead}: ${low(clean(d.gap))}. Esta situación adquiere relevancia porque ${low(clean(d.consequence))}. En consecuencia, resulta pertinente investigar ${subject} ${scope}, mediante ${method}, con el propósito de generar evidencia sistemática que contribuya a su comprensión y sustente decisiones académicas o profesionales.`;
      const routes=[
        {focus:'Alcance descriptivo',topic:`Caracterización de ${subject} en ${place}: estudio centrado en ${population}${periodPhrase}`,question:`¿Cómo se caracteriza ${subject} en ${place}, tomando como unidad de análisis ${population}${periodPhrase}?`,objective:`Caracterizar ${subject} en ${place}, tomando como unidad de análisis ${population}${periodPhrase}, mediante ${method}.`},
        {focus:'Alcance analítico',topic:`Factores asociados con ${subject} en ${place}: análisis de ${population}${periodPhrase}`,question:`¿Qué factores se asocian con ${subject} en ${place}, tomando como unidad de análisis ${population}${periodPhrase}?`,objective:`Analizar los factores asociados con ${subject} en ${place}, tomando como unidad de análisis ${population}${periodPhrase}, mediante ${method}.`},
        d.problemType==='Problema de la práctica'
          ?{focus:'Alcance aplicado',topic:`Diseño de una estrategia para fortalecer ${subject} en ${place}, dirigida a ${population}${periodPhrase}`,question:`¿Qué componentes debe integrar una estrategia fundamentada para fortalecer ${subject} en ${place}, dirigida a ${population}${periodPhrase}?`,objective:`Diseñar una estrategia fundamentada para fortalecer ${subject} en ${place}, dirigida a ${population}${periodPhrase}, a partir de ${method}.`}
          :d.problemType==='Debate entre posturas'
            ?{focus:'Alcance comparativo',topic:`Perspectivas sobre ${subject} en ${place}: análisis comparativo centrado en ${population}${periodPhrase}`,question:`¿En qué aspectos convergen y divergen las principales perspectivas sobre ${subject} en ${place}, al analizarlas en relación con ${population}${periodPhrase}?`,objective:`Comparar las principales perspectivas sobre ${subject} en ${place}, en relación con ${population}${periodPhrase}, mediante ${method}.`}
            :{focus:'Alcance explicativo',topic:`Condiciones y necesidades para el desarrollo de ${subject} en ${place}: estudio con ${population}${periodPhrase}`,question:`¿Qué condiciones y necesidades inciden en el desarrollo de ${subject} en ${place}, considerando como unidad de análisis ${population}${periodPhrase}?`,objective:`Determinar las condiciones y necesidades que inciden en el desarrollo de ${subject} en ${place}, considerando como unidad de análisis ${population}${periodPhrase}, mediante ${method}.`}
      ];
      last={problem,routes};selectedIndex=0;document.querySelector('#problem').textContent=problem;renderRoutes();document.querySelector('#result').classList.add('on');document.querySelector('#result').scrollIntoView({behavior:'smooth'})
    };
    form.addEventListener('input',save);form.addEventListener('submit',e=>{e.preventDefault();if(!validate())return;if(step<3){step++;draw();scrollTo({top:500,behavior:'smooth'})}else build()});document.querySelector('#prev').onclick=()=>{if(step){step--;draw()}};document.querySelectorAll('input[name=problemType]').forEach(r=>r.onchange=()=>{document.querySelectorAll('.sourceType label').forEach(l=>l.classList.toggle('selected',l.contains(r)&&r.checked));save()});document.querySelector('#edit').onclick=()=>{document.querySelector('#result').classList.remove('on');step=2;draw();document.querySelector('.app').scrollIntoView({behavior:'smooth'})};document.querySelector('#restart').onclick=()=>{form.reset();localStorage.removeItem('tesis-problema-html');document.querySelector('#result').classList.remove('on');step=0;selectedIndex=0;draw();scrollTo({top:0,behavior:'smooth'})};document.querySelector('#download').onclick=()=>{if(!last)return;const selected=last.routes[selectedIndex],others=last.routes.filter((_,i)=>i!==selectedIndex).map((route,i)=>`${i+1}. ${route.topic}`),text=['CONSTRUCTOR DEL PROBLEMA DE INVESTIGACIÓN','','PLANTEAMIENTO ORIENTATIVO',last.problem,'',`RUTA SELECCIONADA · ${selected.focus.toUpperCase()}`,'','TEMA DE INVESTIGACIÓN',selected.topic,'','PREGUNTA DE INVESTIGACIÓN',selected.question,'','OBJETIVO GENERAL',selected.objective,'','OTRAS OPCIONES DE TEMA',...others,'','Nota: resultado orientativo. Debe contrastarse con la literatura especializada y revisarse con la dirección de tesis.'].join('\n');const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([text],{type:'text/plain;charset=utf-8'}));a.download='propuesta-problema-investigacion.txt';a.click();URL.revokeObjectURL(a.href)};document.querySelector('#theme').onclick=()=>{const dark=document.documentElement.dataset.theme==='dark';document.documentElement.dataset.theme=dark?'light':'dark';document.querySelector('#theme').textContent=dark?'☾ Modo oscuro':'☀ Modo claro';localStorage.setItem('tesis-problema-theme',dark?'light':'dark')};restore();document.querySelectorAll('.sourceType label').forEach(l=>l.classList.toggle('selected',l.querySelector('input').checked));const th=localStorage.getItem('tesis-problema-theme');if(th)document.documentElement.dataset.theme=th;document.querySelector('#theme').textContent=th==='dark'?'☀ Modo claro':'☾ Modo oscuro';draw();
  })();
  </script>
